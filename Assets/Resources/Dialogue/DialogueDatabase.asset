  m_Script: {fileID: 11500000, guid: 29e6de23d09198f4597e6a3842479be7, type: 3}
  m_Name: DialogueDatabase
  m_EditorClassIdentifier: 
  entries:
  - day: 1
    eventId: 10
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: "Ti\u1EBFng b\u1ED9 \u0111\xE0m"
      text: "Alo, anh Tu\u1EA5n c\xF3 \u0111\xF3 kh\xF4ng,"
      questAction: 0
      questId: 0
    - speakerName: "Ti\u1EBFng b\u1ED9 \u0111\xE0m"
      text: "N\u1EBFu anh nghe th\u1EA5y h\xE3y tr\u1EA3 l\u1EDDi l\u1EA1i t\xF4i
        ngay"
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "T\xF4i, T\xF4i Tu\u1EA5n, xin ch\xE0o"
      questAction: 0
      questId: 0
    - speakerName: "Ti\u1EBFng b\u1ED9 \u0111\xE0m"
      text: "Ng\u01B0\u1EDDi m\u1EDBi, Anh c\xF3 bi\u1EBFt gi\u1EDD \u0111\xE3 l\xE0
        gi\u1EEFa tr\u01B0a r\u1ED3i ch\u1EE9"
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "Xin l\u1ED7i, h\xF4m qua di chuy\u1EC3n \u0111\u1EBFn \u0111\xE2y kh\xE1
        xa n\xEAn t\xF4i c\xF3 ch\xFAt m\u1EC7t"
      questAction: 0
      questId: 0
    - speakerName: "Ti\u1EBFng b\u1ED9 \u0111\xE0m"
      text: "N\u1EBFu anh y\u1EBFu \u0111u\u1ED1i v\u1EADy th\xEC t\xF4i kh\xF4ng
        ngh\u0129 anh c\xF3 th\u1EC3 l\xE0m vi\u1EC7c trong r\u1EEBng \u0111\xE2u"
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "T\xF4i \u1ED5n, kh\xF4ng sao \u0111\xE2u, c\xF3 th\u1EC3 l\xE0 ch\u01B0a
        quen th\xF4i"
      questAction: 0
      questId: 0
  - day: 1
    eventId: 30
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: Nhi
      text: "\u0110\u01B0\u1EE3c r\u1ED3i, t\xF4i l\xE0 Nhi, ng\u01B0\u1EDDi s\u1EBD
        l\xE0m vi\u1EC7c c\xF9ng anh \u1EDF \u0111\xE2y"
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "c\xF2n c\xF4ng vi\u1EC7c c\u1EE7a anh l\xE0 nghe nh\u1EEFng g\xEC t\xF4i
        b\u1EA3o"
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "t\xF4i hi\u1EC3u, v\u1EADy gi\u1EDD t\xF4i c\u1EA7n l\xE0m g\xEC"
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "B\xE2y gi\u1EDD anh h\xE3y h\u01B0\u1EDBng ra h\u1ED3 \u0111\u1EC3 ki\u1EC3m
        tra xem c\xF3 g\xEC b\u1EA5t th\u01B0\u1EDDng kh\xF4ng."
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "t\xF4i hi\u1EC3u r\u1ED3i"
      questAction: 0
      questId: 0
    - speakerName: System
      text: "H\xE3y \u0111\u1EC3 \xFD \u0111\u1EBFn nh\u1EEFng t\u1EA5m bi\u1EC3n
        ch\u1EC9 \u0111\u01B0\u1EDDng."
      questAction: 0
      questId: 0
  - day: 1
    eventId: 50
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: "Hi\u1EC3n"
      text: "T\xF4i \u0111\xE3 ph\xE1 h\u1EE7y xong to\xE0n b\u1ED9 b\u1EABy."
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "Anh \u0111\xE3 ph\xE1 \u0111\u01B0\u1EE3c \"3\" c\xE1i b\u1EABy nh\u1EC9."
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: ...
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "T\u1ED1t l\u1EAFm, b\xE2y gi\u1EDD anh c\xF3 th\u1EC3 tr\u1EDF v\u1EC1
        c\u0103n cabin \u0111\u1EC3 ngh\u1EC9 ng\u01A1i."
      questAction: 0
      questId: 0
  - day: 1
    eventId: 20
    playerCanMove: 0
    timeScale: 1
    lines:
    - speakerName: "Tu\u1EA5n"
      text: "C\xF3 m\u1ED9t v\xE0i con l\u1EE3n r\u1EEBng \u1EDF \u0111\xE2y."
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "ch\xFAng c\xF3 r\u1EA5t nhi\u1EC1u trong r\u1EEBng v\xE0 hay ph\xE1
        ho\u1EA1i c\xE2y c\u1ED1i, khi \u0111\xF3i anh c\xF3 th\u1EC3 s\u0103n ch\xFAng
        \u0111\u1EC3 l\u1EA5y th\u1ECBt."
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "T hi\u1EC3u r\u1ED3i."
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "V\xE0 quan tr\u1ECDng, h\xE3y \u0111\u1EC3 \xFD th\u1EC3 l\u1EF1c c\u1EE7a
        m\xECnh \u0111\u1EEBng \u0111\u1EC3 b\u1ECB ki\u1EC7t s\u1EE9c trong r\u1EEBng
        r\u1EA5t nguy hi\u1EC3m. "
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "S\u0103n l\u1EE3n hay c\xE2u c\xE1 \u0111\u1EC1u s\u1EBD t\u1ED1n th\u1EC3
        l\u1EF1c, h\xE3y anh c\xF3 th\u1EC3 ch\u1EB7t \xEDt c\xE2y, \u0111\u1ED1t
        l\u1EEDa \u0111\u1EC3 n\u1EA5u \u0103n. "
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "\u0110\u01B0\u01A1ng nhi\xEAn ch\u1EB7t c\xE2y c\u0169ng s\u1EBD r\u1EA5t
        m\u1EC7t, h\xE3y \u0103n u\u1ED1ng \u0111\u1EC3 b\u1ED5 sung th\u1EC3 l\u1EF1c."
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "\u0110\u01B0\u1EE3c, t\xF4i hi\u1EC3u r\u1ED3i"
      questAction: 0
      questId: 0
  - day: 1
    eventId: 40
    playerCanMove: 0
    timeScale: 1
    lines:
    - speakerName: "Hi\u1EC3n"
      text: "T\xF4i \u0111\xE3 t\u1EDBi v\xF9ng ven h\u1ED3, kh\xF4ng ph\xE1t hi\u1EC7n
        g\xEC b\u1EA5t th\u01B0\u1EDDng."
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "T\u1ED1t, gi\u1EDD h\xE3y quay tr\u1EDF l\u1EA1i v\xE0 h\u01B0\u1EDBng
        v\u1EC1 c\xE1nh r\u1EEBng phia t\xE2y ki\u1EC3m tra"
      questAction: 0
      questId: 0
    - speakerName: System
      text: "B\u1EA1n c\xF3 th\u1EC3 c\xE2u c\xE1 \u1EDF \u0111\xE2y b\u1EB1ng c\xE1ch
        t\u01B0\u01A1ng t\xE1c E b\xEAn h\u1ED3"
      questAction: 0
      questId: 0
  - day: 1
    eventId: 90
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: "Tu\u1EA5n"
      text: "T\xF4i ph\xE1t hi\u1EC7n th\u1EE9 g\xEC \u0111\xF3.."
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n "
      text: "B\u1EABy th\xFA?"
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "\u0110\xE3 x\xE1c nh\u1EADn \u0111\xF3 l\xE0 b\u1EABy t\u1EEB nh\u1EEFng
        k\u1EBB \u0111\xE1nh b\u1EAFt \u0111\u1ED9ng v\u1EADt tr\xE1i ph\xE9p."
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "H\xE3y ti\u1EBFn h\xE0nh ph\xE1 h\u1EE7y h\u1EBFt s\u1ED1 b\u1EABy."
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "\u0110\xE3 r\xF5"
      questAction: 1
      questId: 10
  - day: 2
    eventId: 10
    playerCanMove: 0
    timeScale: 1
    lines:
    - speakerName: Nhi
      text: "Ch\xE0o bu\u1ED5i s\xE1ng!"
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "Xin ch\xE0o"
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "t\u1ED1i qua ng\u1EE7 ngon ch\u1EE9"
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "t\xF4i ng\u1EE7 ngon, c\u1EA3m \u01A1n."
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "T\u1ED1t v\xEC h\xF4m nay anh s\u1EBD c\u1EA7n \u0111i xa \u0111\u1EA5y."
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "\u0110\xE3 r\xF5, xin h\xE3y d\u1EABn \u0111\u01B0\u1EDDng."
      questAction: 0
      questId: 0
  - day: 2
    eventId: 30
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: Nhi
      text: "H\xE3y quay l\u1EA1i r\xECa r\u1EEBng h\xF4m qua"
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "v\xE0 ti\u1EBFp t\u1EE5c \u0111i theo bi\u1EC3n ch\u1EC9 \u0111\u1EABn,
        n\xF3 s\u1EBD d\u1EABn anh \u0111\u1EBFn tr\u1EA1m ph\xE1t s\xF3ng"
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "H\xE3y t\u1EDBi \u0111\xF3 ki\u1EC3m tra v\xE0 \u0111\u1EA3m b\u1EA3o
        m\u1ECDi th\u1EE9 v\u1EABn \u1ED5n."
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "\u0110\xE3 r\xF5."
      questAction: 0
      questId: 0
  - day: 2
    eventId: 100
    playerCanMove: 0
    timeScale: 1
    lines:
    - speakerName: "Tu\u1EA5n"
      text: "t\xF4i \u0111\xE3 \u0111\u1EBFn tr\u1EA1m, c\xF3 v\u1EBB nh\u01B0 v\u1EABn
        ho\u1EA1t \u0111\u1ED9ng \u1ED5n"
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "\u0110\u1EC3 ch\u1EAFc ch\u1EAFn, anh c\xF3 th\u1EA5y g\xEC l\u1EA1
        n\u1EEFa kh\xF4ng"
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "T\xF4i th\u1EA5y m\u1ED9t t\u1EDD ghi s..."
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "T\u1ED1t l\u1EAFm, kh\xF4ng c\xF3 g\xEC b\u1EA5t th\u01B0\u1EDDng, c\u1EA3m
        \u01A1n v\u1EC1 s\u1EF1 c\u1ED1 g\u1EAFng c\u1EE7a anh."
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "\u1EDD \u1EEBm,.. T\xF4i hi\u1EC3u r\u1ED3i."
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: .....
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "C\xF4 \u1EA5y h\xE0nh x\u1EED l\u1EA1 th\u1EADt"
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "C\xF5 l\u1EBD m\xECnh n\xEAn s\u0103n m\u1ED9t v\xE0i con l\u1EE3n r\u1EEBng
        tr\u01B0\u1EDBc khi tr\u1EDF v\u1EC1"
      questAction: 1
      questId: 30
  - day: 2
    eventId: 50
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: "Tu\u1EA5n"
      text: "\u0110\u1EBFn l\xFAc tr\u1EDF v\u1EC1 r"
      questAction: 0
      questId: 0
  - day: 3
    eventId: 10
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: "Tu\u1EA5n"
      text: "Alo anh Tu\u1EA5n nghe r\xF5 kh\xF4ng"
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "T\xF4i \u0111ang nghe \u0111\xE2y"
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "H\xF4m nay vi\u1EC7c \u0111\u01A1n gi\u1EA3n, h\xE3y \u0111i ch\u1EB7t
        \"5\" kh\xFAc g\xF5 r\u1ED3i \u0111em ch\u1EA5t b\xEAn c\u1EA1nh c\u0103n
        cabin"
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "Sau h\xF4m qua leo \u0111\u1ED3i th\xEC h\xF4m nay \u0111\u01B0\u1EE3c
        l\xE0m ti\u1EC1u phu \xE0?"
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "Anh c\xF3 th\u1EC3 coi \u0111\xF3 l\xE0 ngh\u1EC9 ng\u01A1i ch\u1EE7
        \u0111\u1ED9ng."
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "C\xF4 gi\u1ECFi bi\u1EBFn vi\u1EC7c n\u1EB7ng th\xE0nh c\xE2u nghe c\xF3
        v\u1EBB nh\u1EB9."
      questAction: 1
      questId: 20
  - day: 3
    eventId: 30
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: "Tu\u1EA5n"
      text: "M\xE0 t\u1EA1i sao c\u1EA7n nhi\u1EC1u g\u1ED7 v\u1EADy?"
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "\u0110\xEAm \u1EDF \u0111\xE2y l\u1EA1nh. V\xE0 n\u1EBFu tr\u1EDDi m\u01B0a,
        g\u1ED7 kh\xF4 s\u1EBD th\xE0nh th\u1EE9 r\u1EA5t qu\xFD."
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "C\xF4 n\xF3i nh\u01B0 bi\u1EBFt ng\xE0y mai s\u1EBD m\u01B0a."
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "T\xF4i c\xF3 theo d\xF5i th\u1EDDi ti\u1EBFt."
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "Trong l\xFAc ch\u1EB7t g\u1ED7 th\xEC anh n\xEAn \u0111i ki\u1EC3m tra
        xung quanh cho ch\u1EAFc, nh\u01B0 l\xE0 \u0111i qua v\xF9ng h\u1ED3 ch\u1EB3ng
        h\u1EA1n."
      questAction: 0
      questId: 0
  - day: 3
    eventId: 70
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: "Tu\u1EA5n"
      text: "Alo t\xF4i \u0111\xE3 ki\u1EBFm \u0111\u1EE7 5 kh\xFAc g\u1ED7"
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "H\xE3y \u0111em s\u1ED1 l\u01B0\u1EE3ng g\u1ED7 \u0111\xF3 ch\u1EA5t
        b\xEAn c\u1EA1nh c\u0103n cabin"
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "ah \u0111\u01B0\u1EE3c th\xF4i..."
      questAction: 0
      questId: 0
  - day: 3
    eventId: 100
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: "Tu\u1EA5n"
      text: "t\xF4i \u0111\xE3 ki\u1EC3m tra v\xF9ng h\u1ED3 kh\xF4ng c\xF3 g\xEC
        b\u1EA5t th\u01B0\u1EDDng"
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "Gi\u1EDD t\xF4i s\u1EBD quay l\u1EA1i c\u0103n cabin v\xE0 k\u1EBFt
        th\xFAc ng\xE0y l\xE0m vi\u1EC7c"
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "\u0110\xE3 x\xE1c nh\u1EADn, anh c\xF3 th\u1EC3 tr\u1EDF v\u1EC1 r\u1ED3i."
      questAction: 0
      questId: 0
    - speakerName: "Ti\u1EBFng \xE2m thanh v\u1ECDng l\u1EA1i"
      text: "C\u1EA1ch..."
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "Th\xED nghi\u1EC7m s\u1ED1 762 \u0111\xE3 ho\xE0n th\xE0nh t\u1ED1t
        nhi\u1EC7m v\u1EE5"
      questAction: 0
      questId: 0
    - speakerName: System
      text: "\u0110i\u1EC1u ph\u1ED1i vi\xEAn gi\u1EDD c\xF4 c\xF3 th\u1EC3 tr\u1EDF
        v\u1EC1 ph\xF2ng c\u1EE7a m\xECnh"
      questAction: 0
      questId: 0
    - speakerName: System
      text: "...Chuy\u1EC3n sang ch\u1EBF \u0111\u1ED9 ch\u1EDD l\u1EC7nh"
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "...Th\xED nghi\u1EC7m?"
      questAction: 0
      questId: 0
  - day: 3
    eventId: 110
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: "Tu\u1EA5n"
      text: "Th\u1EE9 n\xE0y...? n\xF3 lu\xF4n \u1EDF \u0111\xE2y ah?"
      questAction: 0
      questId: 0
    - speakerName: "\xC2m thanh l\u1EA1"
      text: "H\xE3y.....ki\u1EBFm......m\u1EADt m\xE3 tr\u01B0\u1EDBc ng\xE0y th\u1EE9
        6"
      questAction: 0
      questId: 0
    - speakerName: "\xC2m thanh l\u1EA1"
      text: "Ng\xE0y th\u1EE9 6 l\xE0 th\u1EDDi \u0111i\u1EC3m chi\u1EBFn d\u1ECBch
        s\u1EBD di\u1EC5n ra,...."
      questAction: 0
      questId: 0
    - speakerName: "\xC2m thanh l\u1EA1"
      text: "C\xF3 ai nghe r\xF5 kh\xF4ng, Xin nh\u1EAFc l\u1EA1i"
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "T\xF4i nghe th\u1EA5y, c\xF3 chuy\u1EC7n g\xEC \u0111ang di\u1EC5n ra
        v\u1EADy??"
      questAction: 0
      questId: 0
    - speakerName: "\xC2m thanh l\u1EA1"
      text: "H\xE3y t\xECm ...... m\u1EADt ......... tho\xE1t ra......ng\xE0y th\u1EE9
        6 tr\u01B0\u1EDBc khi... b\u1ECB ph\xE1 h\u1EE7y"
      questAction: 0
      questId: 0
  - day: 3
    eventId: 50
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: "Tu\u1EA5n"
      text: "M\xECnh kh\xF4ng t\xE0i n\xE0o b\u1ECF qua \u0111\u01B0\u1EE3c nh\u1EEFng
        hi\u1EC7n t\u01B0\u1EE3ng k\u1EF3 l\u1EA1 \u0111\xF3 ra kh\u1ECFi \u0111\u1EA7u..."
      questAction: 0
      questId: 0
  - day: 4
    eventId: 10
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: Nhi
      text: "Tu\u1EA5n, d\u1EADy \u0111i. Nghe t\xF4i n\xF3i r\xF5 kh\xF4ng?"
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "T\xF4i nghe... ngo\xE0i kia m\u01B0a l\u1EDBn qu\xE1."
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "\u0110\xFAng. V\xE0 anh c\u1EA7n ra ngo\xE0i ngay."
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "Ra ngo\xE0i trong m\u01B0a? "
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "\u0110\u1ED1ng g\u1ED7 c\u1EA1nh cabin ph\u1EA3i \u0111\u01B0\u1EE3c
        ph\u1EE7 b\u1EA1t l\u1EA1i tr\u01B0\u1EDBc khi \u01B0\u1EDBt h\u1EBFt."
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "ah ph\u1EA3i r\u1ED3i"
      questAction: 0
      questId: 0
  - day: 4
    eventId: 30
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: "Tu\u1EA5n"
      text: "Nhi... chuy\u1EC7n h\xF4m qua l\xE0 g\xEC? Th\xED nghi\u1EC7m s\u1ED1
        762 l\xE0 sao?"
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: .....
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "H\xE3y mau ph\u1EE7 k\xEDn b\xF3 b\xF3 g\u1ED7"
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "C\xF4 \u0111ang run \xE0?"
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "\u0110\u01B0\u1EDDng truy\u1EC1n \u0111ang nhi\u1EC5u."
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "Kh\xF4ng. Gi\u1ECDng c\xF4 \u0111ang run."
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "...\u1EEA"
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "Nhi, \u0111\xE2y l\xE0 \u0111\xE2u?"
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "M\u1ED9t n\u01A1i kh\xF4ng n\xEAn t\u1ED3n t\u1EA1i."
      questAction: 0
      questId: 0
  - day: 4
    eventId: 100
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: "Tu\u1EA5n"
      text: "T\xF4i \u0111ang ph\u1EE7 b\u1EA1t. Gi\u1EDD n\xF3i \u0111i."
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "C\u01A1n m\u01B0a n\xE0y kh\xF4ng ph\u1EA3i th\u1EDDi ti\u1EBFt th\u1EADt."
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "\xDD c\xF4 l\xE0 sao?"
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "T\u1ED5 ch\u1EE9c c\u1EE7a t\xF4i \u0111ang t\u1EA5n c\xF4ng v\xE0o
        m\u1EA1ng l\u01B0\u1EDBi c\u1EE7a VING. M\u01B0a l\xE0 l\u1EDBp nhi\u1EC5u
        \u0111\u01B0\u1EE3c \u0111\u1EA9y v\xE0o m\xF4 ph\u1ECFng \u0111\u1EC3 l\xE0m
        ch\u1EADm h\u1EC7 th\u1ED1ng gi\xE1m s\xE1t."
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "M\xF4 ph\u1ECFng?"
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "Th\u1EBF gi\u1EDBi anh \u0111ang th\u1EA5y kh\xF4ng ph\u1EA3i th\u1EADt.
        Cabin, khu r\u1EEBng, h\u1ED3, tr\u1EA1m ph\xE1t s\xF3ng... t\u1EA5t c\u1EA3
        l\xE0 m\xF4i tr\u01B0\u1EDDng nghi\xEAn c\u1EE9u h\xE0nh vi."
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "Anh v\xE0 nhi\u1EC1u ng\u01B0\u1EDDi kh\xE1c \u0111ang b\u1ECB nh\u1ED1t
        \u0111\u1EC3 VING h\u1ECDc c\xE1ch t\u1EA1o ra \u0111\u1ED9i qu\xE2n AI c\xF3
        th\u1EC3 ra quy\u1EBFt \u0111\u1ECBnh ngo\xE0i chi\u1EBFn tr\u01B0\u1EDDng
        nh\u01B0 con ng\u01B0\u1EDDi."
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "T\xF4i l\xE0 t\xF9 nh\xE2n?"
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "Anh l\xE0 \u0111\u1ED1i t\u01B0\u1EE3ng th\xED nghi\u1EC7m"
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "Nh\u1EEFng vi\u1EC7c anh l\xE0m h\xE0ng ng\xE0y, c\xE1ch anh ho\u1EA1t
        \u0111\u1ED9ng,..\""
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "N\xF3 c\u0169ng gi\xFAp h\u1ECD t\u1EA1o AI kh\xF4ng ch\u1EC9 bi\u1EBFt
        tu\xE2n l\u1EC7nh, m\xE0 c\xF2n bi\u1EBFt \u1EE9ng bi\u1EBFn nh\u01B0 ng\u01B0\u1EDDi
        th\u1EADt."
      questAction: 0
      questId: 0
  - day: 4
    eventId: 110
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: "Tu\u1EA5n"
      text: "C\xF2n c\xF4? C\xF4 l\xE0 ai?"
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "T\xF4i thu\u1ED9c nh\xF3m ch\u1ED1ng l\u1EA1i VING. H\u1ECD g\u1ECDi
        ch\xFAng t\xF4i l\xE0 ph\u1EA3n \u0111\u1ED9ng. Ch\xFAng t\xF4i g\u1ECDi
        m\xECnh l\xE0 Steins Gate."
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "V\u1EADy t\u1EEB \u0111\u1EA7u c\xF4 \u0111\xE3 gi\xFAp t\xF4i?"
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "T\xF4i nghe gi\u1ECDng n\xF3i ng\xE0y th\u1EE9 6 c\xF3 chi\u1EBFn d\u1ECBch.
        Chi\u1EBFn d\u1ECBch g\xEC?"
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "VING s\u1EBD tr\xEDch xu\u1EA5t d\u1EEF li\u1EC7u t\u1EEB c\xE1c \u0111\u1ED1i
        t\u01B0\u1EE3ng c\xF2n s\u1ED1ng, r\u1ED3i x\xF3a m\xF4 ph\u1ECFng ph\u1EE5."
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "X\xF3a ngh\u0129a l\xE0 sao?"
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "V\u1EDBi anh, c\xF3 th\u1EC3 l\xE0 ch\u1EBFt. C\xF3 th\u1EC3 l\xE0 b\u1ECB
        reset. T\xF4i kh\xF4ng bi\u1EBFt c\xE1i n\xE0o t\u1EC7 h\u01A1n."
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "Ch\xFAng t\xF4i s\u1EBD m\u1EDF chi\u1EBFn d\u1ECBch t\u1EA5n c\xF4ng
        t\u1EDBi tr\u1EA1m nghi\xEAn c\u1EE9u v\xE0o th\u1EDDi \u0111i\u1EC3m \u0111\xF3."
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "Nh\u01B0ng hi\u1EC7n ch\xFAng t\xF4i kh\xF4ng m\u1EDF \u0111\u01B0\u1EE3c
        m\xE3 kh\xF3a l\xF5i"
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "M\xE3 kh\xF3a n\xE0o?"
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "Th\u1EBF gi\u1EDBi c\u1EE7a anh \u0111ang b\u1ECB m\xE3 h\xF3a b\u1EB1ng
        m\u1ED9t kh\xF3a h\xE0nh vi. Ch\xFAng t\xF4i kh\xF4ng th\u1EC3 gi\xFAp anh
        \u0111\u01B0\u1EE3c."
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "V\u1EADy t\xF4i l\xE0 ng\u01B0\u1EDDi duy nh\u1EA5t t\u1EF1 m\u1EDF
        \u0111\u01B0\u1EE3c?"
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "\u0110\xFAng r\u1ED3i tr\u01B0\u1EDBc \u0111\xE2y anh l\xE0 l\u1EADp
        tr\xECnh vi\xEAn \u0111\xF9ng kh\xF4ng? n\u1EBFu d\xF9ng c\xE1ch \u0111\xF3
        th\xEC c\xF3 th\u1EC3 \u0111\u1EA5y."
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "Ng\xE0y Mai t\xF4i s\u1EBD g\u1EEDi n\xF3 \u0111\u1EBFn cho anh"
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "gi\u1EDD anh c\xF3 th\u1EC3 quay v\u1EC1 gi\u01B0\u1EDDng ngh\u1EC9
        nh\u01B0 m\u1ECDi khi"
      questAction: 0
      questId: 0
  - day: 5
    eventId: 30
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: Nhi
      text: "Khu tr\xFA \u1EA9n c\u1EA7n th\xEAm nhi\xEAn li\u1EC7u d\u1EF1 ph\xF2ng."
      questAction: 0
      questId: 0
    - speakerName: "Hi\u1EC3n"
      text: "C\u1EA7n nhi\u1EC1u g\u1ED7 h\u01A1n h\xF4m tr\u01B0\u1EDBc \u0111\xFAng
        kh\xF4ng."
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "\u0110\xFAng v\u1EADy. Gom cho t\xF4i 5 kh\xFAc g\u1ED7 tr\u01B0\u1EDBc
        l\xFAc h\u1EBFt ng\xE0y."
      questAction: 0
      questId: 0
    - speakerName: "Hi\u1EC3n"
      text: "\u0110\xE3 r\xF5. T\xF4i \u0111i ngay."
      questAction: 1
      questId: 50
  - day: 5
    eventId: 50
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: "Hi\u1EC3n"
      text: "T\xF4i \u0111\xE3 ch\u1EB7t \u0111\u1EE7 s\u1ED1 g\u1ED7 c\u1EA7n thi\u1EBFt."
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "T\u1ED1t. Ch\xFAng ta \u0111\xE3 s\u1EB5n s\xE0ng h\u01A1n r\u1EA5t
        nhi\u1EC1u."
      questAction: 0
      questId: 0
  - day: 6
    eventId: 30
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: Nhi
      text: "H\xF4m nay l\xE0 ng\xE0y cu\u1ED1i trong \u0111\u1EE3t tr\u1EF1c n\xE0y."
      questAction: 0
      questId: 0
    - speakerName: "Hi\u1EC3n"
      text: "T\xF4i c\u1EA7n l\xE0m g\xEC tr\u01B0\u1EDBc khi r\u1EDDi khu r\u1EEBng."
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "C\xE2u th\xEAm 4 con c\xE1, r\u1ED3i ch\xFAng ta s\u1EBD k\u1EBFt th\xFAc
        \u0111\u1EE3t c\xF4ng t\xE1c."
      questAction: 0
      questId: 0
    - speakerName: "Hi\u1EC3n"
      text: "\u0110\xE3 r\xF5. T\xF4i s\u1EBD ho\xE0n t\u1EA5t tr\u01B0\u1EDBc khi
        tr\u1EDDi t\u1ED1i."
      questAction: 1
      questId: 60
  - day: 6
    eventId: 50
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: "Hi\u1EC3n"
      text: "T\xF4i \u0111\xE3 xong chuy\u1EBFn c\xE2u cu\u1ED1i c\xF9ng."
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "T\u1ED1t. Ch\xFAng ta k\u1EBFt th\xFAc \u0111\u1EE3t l\xE0m vi\u1EC7c
        t\u1EA1i \u0111\xE2y."
      questAction: 0
      questId: 0
