%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 29e6de23d09198f4597e6a3842479be7, type: 3}
  m_Name: DialogueDatabase
  m_EditorClassIdentifier: 
  entries:
  - day: 1
    eventId: 10
    playerCanMove: 0
    timeScale: 1
    lines:
    - speakerName: Tieng bo dam
      text: Alo, anh Hien co nghe ro khong. Neu nghe thay hay tra loi lai.
    - speakerName: Hien
      text: Toi nghe ro. Toi da co mat tai tram.
    - speakerName: Tieng bo dam
      text: Day la ngay dau tien cua anh, dung de tre them nua.
    - speakerName: Hien
      text: Toi hieu roi, toi se vao viec ngay.
  - day: 1
    eventId: 30
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: Nhi
      text: Hom nay co bay dam o phia Tay khu rung.
    - speakerName: Hien
      text: Toi can xu ly bao nhieu cai.
    - speakerName: Nhi
      text: Chi con 3 cai bay dang can duoc pha huy.
    - speakerName: Hien
      text: Da ro. Toi di ngay.
      questAction: 1
      questId: 10
  - day: 1
    eventId: 40
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: Hien
      text: O gan day co cho nao cau ca duoc khong.
    - speakerName: Nhi
      text: Men theo dong suoi se thay mot cai ho nho. O do co the cau duoc ca.
  - day: 1
    eventId: 20
    playerCanMove: 0
    timeScale: 1
    lines:
    - speakerName: Hien
      text: Toi vua thay lon rung o day.
    - speakerName: Nhi
      text: Dung de y thoi luc. Neu can thi co the san de lay thit.
    - speakerName: Nhi
      text: Chat cay, san va cau ca deu lam mat suc. Nho bo sung thuc an.
  - day: 1
    eventId: 50
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: Hien
      text: Toi da pha huy xong toan bo bay dam.
    - speakerName: Nhi
      text: Tot. Ve nghi mot dem, sang mai chung ta doi viec.
  - day: 2
    eventId: 30
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: Nhi
      text: Dem qua rat lanh, hom nay hay gom them go kho de dot lua.
    - speakerName: Hien
      text: So luong can la bao nhieu.
    - speakerName: Nhi
      text: Mang ve cho toi 3 khuc go truoc khi het ngay.
    - speakerName: Hien
      text: Da ro. Toi bat dau ngay.
      questAction: 1
      questId: 20
  - day: 2
    eventId: 50
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: Hien
      text: Toi da gom du 3 khuc go.
    - speakerName: Nhi
      text: Tot. Lua toi nay se on hon. Nghi ngoi di.
  - day: 3
    eventId: 30
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: Nhi
      text: Nguon do an du tru dang it dan.
    - speakerName: Hien
      text: Toi can bo sung loai nao.
    - speakerName: Nhi
      text: Hay lay cho toi 2 mieng thit truoc luc troi toi.
    - speakerName: Hien
      text: Da hieu. Toi se san nhanh roi quay lai.
      questAction: 1
      questId: 30
  - day: 3
    eventId: 50
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: Hien
      text: Toi da mang ve du so thit can dung.
    - speakerName: Nhi
      text: Lam tot lam. Hom nay ket thuc o day.
  - day: 4
    eventId: 30
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: Nhi
      text: Suoi len muc, day la luc tot de cau them ca.
    - speakerName: Hien
      text: Muc tieu hom nay la gi.
    - speakerName: Nhi
      text: Bat cho toi 3 con ca truoc khi het ngay.
    - speakerName: Hien
      text: Da ro. Toi di ra ho ngay.
      questAction: 1
      questId: 40
  - day: 4
    eventId: 50
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: Hien
      text: Ca da du roi.
    - speakerName: Nhi
      text: Tot. Chung ta co them thuc an cho ngay mai.
  - day: 5
    eventId: 30
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: Nhi
      text: Khu tru an can them nhien lieu du phong.
    - speakerName: Hien
      text: Can nhieu go hon hom truoc dung khong.
    - speakerName: Nhi
      text: Dung vay. Gom cho toi 5 khuc go truoc luc het ngay.
    - speakerName: Hien
      text: Da ro. Toi di ngay.
      questAction: 1
      questId: 50
  - day: 5
    eventId: 50
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: Hien
      text: Toi da chat du so go can thiet.
    - speakerName: Nhi
      text: Tot. Chung ta da san sang hon rat nhieu.
  - day: 6
    eventId: 30
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: Nhi
      text: Hom nay la ngay cuoi trong dot truc nay.
    - speakerName: Hien
      text: Toi can lam gi truoc khi roi khu rung.
    - speakerName: Nhi
      text: Cau them 4 con ca, roi chung ta se ket thuc dot cong tac.
    - speakerName: Hien
      text: Da ro. Toi se hoan tat truoc khi troi toi.
      questAction: 1
      questId: 60
  - day: 6
    eventId: 50
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: Hien
      text: Toi da xong chuyen cau cuoi cung.
    - speakerName: Nhi
      text: Tot. Chung ta ket thuc dot lam viec tai day.
