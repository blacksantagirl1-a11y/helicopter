--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 29e6de23d09198f4597e6a3842479be7, type: 3}
  m_Name: DialogueDatabase
  m_EditorClassIdentifier: 
  entries:
  - day: 1
    eventId: 10
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: "Ti\u1EBFng b\u1ED9 \u0111\xE0m"
      text: "Alo, anh Tu\u1EA5n c\xF3 \u0111\xF3 kh\xF4ng,"
      questAction: 0
      questId: 0
    - speakerName: "Ti\u1EBFng b\u1ED9 \u0111\xE0m"
      text: "N\u1EBFu anh nghe th\u1EA5y h\xE3y tr\u1EA3 l\u1EDDi l\u1EA1i t\xF4i
        ngay"
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "T\xF4i, T\xF4i Tu\u1EA5n, xin ch\xE0o"
      questAction: 0
      questId: 0
    - speakerName: "Ti\u1EBFng b\u1ED9 \u0111\xE0m"
      text: "Ng\u01B0\u1EDDi m\u1EDBi, Anh c\xF3 bi\u1EBFt gi\u1EDD \u0111\xE3 l\xE0
        gi\u1EEFa tr\u01B0a r\u1ED3i ch\u1EE9"
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "Xin l\u1ED7i, h\xF4m qua di chuy\u1EC3n \u0111\u1EBFn \u0111\xE2y kh\xE1
        xa n\xEAn t\xF4i c\xF3 ch\xFAt m\u1EC7t"
      questAction: 0
      questId: 0
    - speakerName: "Ti\u1EBFng b\u1ED9 \u0111\xE0m"
      text: "N\u1EBFu anh y\u1EBFu \u0111u\u1ED1i v\u1EADy th\xEC t\xF4i kh\xF4ng
        ngh\u0129 anh c\xF3 th\u1EC3 l\xE0m vi\u1EC7c trong r\u1EEBng \u0111\xE2u"
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "T\xF4i \u1ED5n, kh\xF4ng sao \u0111\xE2u, c\xF3 th\u1EC3 l\xE0 ch\u01B0a
        quen th\xF4i"
      questAction: 0
      questId: 0
  - day: 1
    eventId: 30
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: Nhi
      text: "\u0110\u01B0\u1EE3c r\u1ED3i, t\xF4i l\xE0 Nhi, ng\u01B0\u1EDDi s\u1EBD
        l\xE0m vi\u1EC7c c\xF9ng anh \u1EDF \u0111\xE2y"
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "c\xF2n c\xF4ng vi\u1EC7c c\u1EE7a anh l\xE0 nghe nh\u1EEFng g\xEC t\xF4i
        b\u1EA3o"
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "t\xF4i hi\u1EC3u, v\u1EADy gi\u1EDD t\xF4i c\u1EA7n l\xE0m g\xEC"
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "B\xE2y gi\u1EDD anh h\xE3y h\u01B0\u1EDBng ra h\u1ED3 \u0111\u1EC3 ki\u1EC3m
        tra xem c\xF3 g\xEC b\u1EA5t th\u01B0\u1EDDng kh\xF4ng."
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "t\xF4i hi\u1EC3u r\u1ED3i"
      questAction: 0
      questId: 0
    - speakerName: System
      text: "H\xE3y \u0111\u1EC3 \xFD \u0111\u1EBFn nh\u1EEFng t\u1EA5m bi\u1EC3n
        ch\u1EC9 \u0111\u01B0\u1EDDng."
      questAction: 0
      questId: 0
  - day: 1
    eventId: 50
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: "Hi\u1EC3n"
      text: "T\xF4i \u0111\xE3 ph\xE1 h\u1EE7y xong to\xE0n b\u1ED9 b\u1EABy."
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "Anh \u0111\xE3 ph\xE1 \u0111\u01B0\u1EE3c \"3\" c\xE1i b\u1EABy nh\u1EC9."
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: ...
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "T\u1ED1t l\u1EAFm, b\xE2y gi\u1EDD anh c\xF3 th\u1EC3 tr\u1EDF v\u1EC1
        c\u0103n cabin \u0111\u1EC3 ngh\u1EC9 ng\u01A1i."
      questAction: 0
      questId: 0
  - day: 1
    eventId: 20
    playerCanMove: 0
    timeScale: 1
    lines:
    - speakerName: "Tu\u1EA5n"
      text: "C\xF3 m\u1ED9t v\xE0i con l\u1EE3n r\u1EEBng \u1EDF \u0111\xE2y."
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "ch\xFAng c\xF3 r\u1EA5t nhi\u1EC1u trong r\u1EEBng v\xE0 hay ph\xE1
        ho\u1EA1i c\xE2y c\u1ED1i, khi \u0111\xF3i anh c\xF3 th\u1EC3 s\u0103n ch\xFAng
        \u0111\u1EC3 l\u1EA5y th\u1ECBt."
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "T hi\u1EC3u r\u1ED3i."
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "V\xE0 quan tr\u1ECDng, h\xE3y \u0111\u1EC3 \xFD th\u1EC3 l\u1EF1c c\u1EE7a
        m\xECnh \u0111\u1EEBng \u0111\u1EC3 b\u1ECB ki\u1EC7t s\u1EE9c trong r\u1EEBng
        r\u1EA5t nguy hi\u1EC3m. "
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "S\u0103n l\u1EE3n hay c\xE2u c\xE1 \u0111\u1EC1u s\u1EBD t\u1ED1n th\u1EC3
        l\u1EF1c, h\xE3y anh c\xF3 th\u1EC3 ch\u1EB7t \xEDt c\xE2y, \u0111\u1ED1t
        l\u1EEDa \u0111\u1EC3 n\u1EA5u \u0103n. "
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "\u0110\u01B0\u01A1ng nhi\xEAn ch\u1EB7t c\xE2y c\u0169ng s\u1EBD r\u1EA5t
        m\u1EC7t, h\xE3y \u0103n u\u1ED1ng \u0111\u1EC3 b\u1ED5 sung th\u1EC3 l\u1EF1c."
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "\u0110\u01B0\u1EE3c, t\xF4i hi\u1EC3u r\u1ED3i"
      questAction: 0
      questId: 0
  - day: 1
    eventId: 40
    playerCanMove: 0
    timeScale: 1
    lines:
    - speakerName: "Hi\u1EC3n"
      text: "T\xF4i \u0111\xE3 t\u1EDBi v\xF9ng ven h\u1ED3, kh\xF4ng ph\xE1t hi\u1EC7n
        g\xEC b\u1EA5t th\u01B0\u1EDDng."
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "T\u1ED1t, gi\u1EDD h\xE3y quay tr\u1EDF l\u1EA1i v\xE0 h\u01B0\u1EDBng
        v\u1EC1 c\xE1nh r\u1EEBng phia t\xE2y ki\u1EC3m tra"
      questAction: 0
      questId: 0
    - speakerName: System
      text: "B\u1EA1n c\xF3 th\u1EC3 c\xE2u c\xE1 \u1EDF \u0111\xE2y b\u1EB1ng c\xE1ch
        t\u01B0\u01A1ng t\xE1c E b\xEAn h\u1ED3"
      questAction: 0
      questId: 0
  - day: 1
    eventId: 90
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: "Tu\u1EA5n"
      text: "T\xF4i ph\xE1t hi\u1EC7n th\u1EE9 g\xEC \u0111\xF3.."
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n "
      text: "B\u1EABy th\xFA?"
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "\u0110\xE3 x\xE1c nh\u1EADn \u0111\xF3 l\xE0 b\u1EABy t\u1EEB nh\u1EEFng
        k\u1EBB \u0111\xE1nh b\u1EAFt \u0111\u1ED9ng v\u1EADt tr\xE1i ph\xE9p."
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "H\xE3y ti\u1EBFn h\xE0nh ph\xE1 h\u1EE7y h\u1EBFt s\u1ED1 b\u1EABy."
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "\u0110\xE3 r\xF5"
      questAction: 1
      questId: 10
  - day: 2
    eventId: 10
    playerCanMove: 0
    timeScale: 1
    lines:
    - speakerName: Nhi
      text: "Ch\xE0o bu\u1ED5i s\xE1ng!"
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "Xin ch\xE0o"
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "t\u1ED1i qua ng\u1EE7 ngon ch\u1EE9"
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "t\xF4i ng\u1EE7 ngon, c\u1EA3m \u01A1n."
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "T\u1ED1t v\xEC h\xF4m nay anh s\u1EBD c\u1EA7n \u0111i xa \u0111\u1EA5y."
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "\u0110\xE3 r\xF5, xin h\xE3y d\u1EABn \u0111\u01B0\u1EDDng."
      questAction: 0
      questId: 0
  - day: 2
    eventId: 30
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: Nhi
      text: "H\xE3y quay l\u1EA1i r\xECa r\u1EEBng h\xF4m qua"
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "v\xE0 ti\u1EBFp t\u1EE5c \u0111i theo bi\u1EC3n ch\u1EC9 \u0111\u1EABn,
        n\xF3 s\u1EBD d\u1EABn anh \u0111\u1EBFn tr\u1EA1m ph\xE1t s\xF3ng"
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "H\xE3y t\u1EDBi \u0111\xF3 ki\u1EC3m tra v\xE0 \u0111\u1EA3m b\u1EA3o
        m\u1ECDi th\u1EE9 v\u1EABn \u1ED5n."
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "\u0110\xE3 r\xF5."
      questAction: 0
      questId: 0
  - day: 2
    eventId: 100
    playerCanMove: 0
    timeScale: 1
    lines:
    - speakerName: "Tu\u1EA5n"
      text: "t\xF4i \u0111\xE3 \u0111\u1EBFn tr\u1EA1m, c\xF3 v\u1EBB nh\u01B0 v\u1EABn
        ho\u1EA1t \u0111\u1ED9ng \u1ED5n"
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "\u0110\u1EC3 ch\u1EAFc ch\u1EAFn, anh c\xF3 th\u1EA5y g\xEC l\u1EA1
        n\u1EEFa kh\xF4ng"
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "T\xF4i th\u1EA5y m\u1ED9t t\u1EDD ghi ch\xFA s..."
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "T\u1ED1t l\u1EAFm, kh\xF4ng c\xF3 g\xEC b\u1EA5t th\u01B0\u1EDDng, c\u1EA3m
        \u01A1n v\u1EC1 s\u1EF1 c\u1ED1 g\u1EAFng c\u1EE7a anh."
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "\u1EDD \u1EEBm,.. T\xF4i hi\u1EC3u r\u1ED3i."
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: .....
      questAction: 0
      questId: 0
    - speakerName: "Tu\u1EA5n"
      text: "C\xF5 l\u1EBD m\xECnh n\xEAn s\u0103n m\u1ED9t v\xE0i con l\u1EE3n r\u1EEBng
        tr\u01B0\u1EDBc khi tr\u1EDF v\u1EC1"
      questAction: 0
      questId: 0
    - speakerName: System
      text: "Nh\u1EA5n F \u0111\u1EC3 trang b\u1ECB v\u0169 kh\xED, chu\u1ED9t tr\xE1i
        \u0111\u1EC3 ch\u1EB7t c\xE2y/l\u1EE3n r\u1EEBng, b\u1EA5m E \u0111\u1EC3
        nh\u1EB7t v\u1EADt ph\u1EA9m."
      questAction: 0
      questId: 0
    - speakerName: System
      text: "L\u1EE3n r\u1EEBng c\u1EA7n ch\xE9m 3 ph\xE1t\nC\xE2y c\u1EA7n ch\u1EB7t
        2 l\u1EA7n"
      questAction: 0
      questId: 0
  - day: 2
    eventId: 50
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: "Tu\u1EA5n"
      text: "\u0110\u1EBFn l\xFAc tr\u1EDF v\u1EC1 r"
      questAction: 0
      questId: 0
  - day: 3
    eventId: 10
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: "Hi\u1EC3n"
      text: "M\xF9i kh\xF3i c\xF2n v\u01B0\u01A1ng trong nh\xE0. B\xF3 g\u1ED7 h\xF4m
        qua ch\u1EAFc v\u1EABn d\xF9ng \u0111\u01B0\u1EE3c."
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "Ki\u1EC3m tra BundOfWood tr\u01B0\u1EDBc. N\u1EBFu \u1ED5n th\xEC tr\u1EA3i
        t\u1EA5m th\u1EA3m ra cho \u1EA5m."
      questAction: 0
      questId: 0
  - day: 3
    eventId: 30
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: "Hi\u1EC3n"
      text: "T\u1EA5m th\u1EA3m \u0111\xE3 \u0111\u01B0\u1EE3c tr\u1EA3i xong."
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "T\u1ED1t. H\xF4m nay ngh\u1EC9 s\u1EDBm, s\xE1ng mai ch\xFAng ta ti\u1EBFp
        t\u1EE5c."
      questAction: 0
      questId: 0
    - speakerName: "Hi\u1EC3n"
      text: "T\xF4i s\u1EBD l\xEAn gi\u01B0\u1EDDng ngh\u1EC9."
      questAction: 0
      questId: 0
  - day: 3
    eventId: 50
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: "Hi\u1EC3n"
      text: "T\xF4i \u0111\xE3 mang v\u1EC1 \u0111\u1EE7 s\u1ED1 th\u1ECBt c\u1EA7n
        d\xF9ng."
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "L\xE0m t\u1ED1t l\u1EAFm. H\xF4m nay k\u1EBFt th\xFAc \u1EDF \u0111\xE2y."
      questAction: 0
      questId: 0
  - day: 4
    eventId: 30
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: Nhi
      text: "Su\u1ED1i l\xEAn m\u1EE9c, \u0111\xE2y l\xE0 l\xFAc t\u1ED1t \u0111\u1EC3
        c\xE2u th\xEAm c\xE1."
      questAction: 0
      questId: 0
    - speakerName: "Hi\u1EC3n"
      text: "M\u1EE5c ti\xEAu h\xF4m nay l\xE0 g\xEC."
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "B\u1EAFt cho t\xF4i 3 con c\xE1 tr\u01B0\u1EDBc khi h\u1EBFt ng\xE0y."
      questAction: 0
      questId: 0
    - speakerName: "Hi\u1EC3n"
      text: "\u0110\xE3 r\xF5. T\xF4i \u0111i ra h\u1ED3 ngay."
      questAction: 1
      questId: 40
  - day: 4
    eventId: 50
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: "Hi\u1EC3n"
      text: "C\xE1 \u0111\xE3 \u0111\u1EE7 r\u1ED3i."
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "T\u1ED1t. Ch\xFAng ta c\xF3 th\xEAm th\u1EE9c \u0103n cho ng\xE0y mai."
      questAction: 0
      questId: 0
  - day: 5
    eventId: 30
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: Nhi
      text: "Khu tr\xFA \u1EA9n c\u1EA7n th\xEAm nhi\xEAn li\u1EC7u d\u1EF1 ph\xF2ng."
      questAction: 0
      questId: 0
    - speakerName: "Hi\u1EC3n"
      text: "C\u1EA7n nhi\u1EC1u g\u1ED7 h\u01A1n h\xF4m tr\u01B0\u1EDBc \u0111\xFAng
        kh\xF4ng."
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "\u0110\xFAng v\u1EADy. Gom cho t\xF4i 5 kh\xFAc g\u1ED7 tr\u01B0\u1EDBc
        l\xFAc h\u1EBFt ng\xE0y."
      questAction: 0
      questId: 0
    - speakerName: "Hi\u1EC3n"
      text: "\u0110\xE3 r\xF5. T\xF4i \u0111i ngay."
      questAction: 1
      questId: 50
  - day: 5
    eventId: 50
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: "Hi\u1EC3n"
      text: "T\xF4i \u0111\xE3 ch\u1EB7t \u0111\u1EE7 s\u1ED1 g\u1ED7 c\u1EA7n thi\u1EBFt."
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "T\u1ED1t. Ch\xFAng ta \u0111\xE3 s\u1EB5n s\xE0ng h\u01A1n r\u1EA5t
        nhi\u1EC1u."
      questAction: 0
      questId: 0
  - day: 6
    eventId: 30
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: Nhi
      text: "H\xF4m nay l\xE0 ng\xE0y cu\u1ED1i trong \u0111\u1EE3t tr\u1EF1c n\xE0y."
      questAction: 0
      questId: 0
    - speakerName: "Hi\u1EC3n"
      text: "T\xF4i c\u1EA7n l\xE0m g\xEC tr\u01B0\u1EDBc khi r\u1EDDi khu r\u1EEBng."
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "C\xE2u th\xEAm 4 con c\xE1, r\u1ED3i ch\xFAng ta s\u1EBD k\u1EBFt th\xFAc
        \u0111\u1EE3t c\xF4ng t\xE1c."
      questAction: 0
      questId: 0
    - speakerName: "Hi\u1EC3n"
      text: "\u0110\xE3 r\xF5. T\xF4i s\u1EBD ho\xE0n t\u1EA5t tr\u01B0\u1EDBc khi
        tr\u1EDDi t\u1ED1i."
      questAction: 1
      questId: 60
  - day: 6
    eventId: 50
    playerCanMove: 1
    timeScale: 1
    lines:
    - speakerName: "Hi\u1EC3n"
      text: "T\xF4i \u0111\xE3 xong chuy\u1EBFn c\xE2u cu\u1ED1i c\xF9ng."
      questAction: 0
      questId: 0
    - speakerName: Nhi
      text: "T\u1ED1t. Ch\xFAng ta k\u1EBFt th\xFAc \u0111\u1EE3t l\xE0m vi\u1EC7c
        t\u1EA1i \u0111\xE2y."
      questAction: 0
      questId: 0
